{
  "name": "DevOps Capstone",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "remoteUser": "vscode",
  "remoteEnv": {
    "FLASK_DEBUG": "True"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.pylint",
        "ms-python.vscode-pylance",
        "redhat.vscode-yaml",
        "GitHub.vscode-pull-request-github",
        "rangav.vscode-thunder-client"
      ]
    }
  }
}
